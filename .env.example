# Banco (Vercel Postgres injeta automaticamente ao conectar o Storage)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Gemini (só no servidor — nunca NEXT_PUBLIC_)
GEMINI_API_KEY=

# Vercel Blob (armazenamento do PDF) — injetado ao conectar um Blob store
BLOB_READ_WRITE_TOKEN=

# Auth.js
AUTH_SECRET=          # gerar com: npx auth secret
NEXTAUTH_URL=http://localhost:3000
